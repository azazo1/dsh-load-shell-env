{
  "name": "dsh-load-shell-env",
  "version": "0.1.0",
  "description": "Load the user's own shell environment (fish/zsh/bash config) into DSH agent commands: a configurable ordered pipeline reads a NUL-separated environment snapshot, a whitelist plus a hand-written .env overlay inject it into every bash command and, behind a switch, into terminal processes, and a settings card offers the on/off switch, manual refresh and custom variables. 把用户自己的 shell 环境 (fish/zsh/bash 配置) 加载进 DSH agent 的命令: 可配置的有序流水线读出一份 NUL 分隔的环境快照, 经白名单与手写的 .env 覆盖层注入每条 bash 命令 (可选也交给终端进程), 配置页提供总开关, 手动刷新与自定义变量.",
  "type": "module",
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh-plugin.naming.json",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsdown --config tsdown.host.config.ts && tsdown --config tsdown.client.config.ts",
    "test": "vitest run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "shell",
    "environment",
    "path",
    "fish"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azazo1/dsh-load-shell-env.git"
  },
  "homepage": "https://github.com/azazo1/dsh-load-shell-env#readme",
  "bugs": {
    "url": "https://github.com/azazo1/dsh-load-shell-env/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@11.24.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-bash-local": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-bash-sandbox": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-shell": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-subprocess": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/schemastery": "~3.18.4",
    "react": ">=18"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/cordis-plugin-include": "^1.0.9",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.5",
    "@deepseek-ai/dsh-bash-local": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-bash-sandbox": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-store": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-plugin-manager": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-sandbox": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-sandbox-local": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-session-projection": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-shell": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-subprocess": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-subprocess-local": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.1",
    "js-yaml": "^4.3.2",
    "react": "^18.2.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
